# ThreatLens API keys
#
# SETUP:
#   1. Make a copy of this file in the same folder and name it exactly  .env
#   2. Paste your keys after the = signs below (no quotes, no spaces)
#   3. Restart the app
#
# The .env file is listed in .gitignore, so your keys never reach GitHub.

# https://www.abuseipdb.com  ->  register  ->  Account  ->  API
# Free tier: 1,000 checks per day
ABUSEIPDB_API_KEY=

# https://www.virustotal.com  ->  sign up  ->  Profile  ->  API Key
# Free tier: 500 lookups per day, 4 per minute
VIRUSTOTAL_API_KEY=

# https://otx.alienvault.com  ->  sign up  ->  Settings  ->  OTX Key
# Optional -- not used until a later week
OTX_API_KEY=
